{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.nexamin.id.vn" }],
      "destination": "https://nexamin.id.vn/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.nexamin.id.vn" }],
      "destination": "https://nexamin.id.vn/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://studyhubai-bar8.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://studyhubai-bar8.onrender.com/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
