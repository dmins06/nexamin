APP_ENV=development
APP_NAME=Nexamin
ASSISTANT_NAME=Emin AI
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://studyhub:change-me@postgres:5432/studyhub
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_ENABLED=true
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:5173
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=studyhub
S3_SECRET_KEY=replace-me
S3_BUCKET=studyhub-documents
S3_REGION=us-east-1
STORAGE_PROVIDER=local
# Separate PRIVATE Blob store token for documents and direct-message files.
# Keep BLOB_READ_WRITE_TOKEN pointing to the existing public avatar/post store.
PRIVATE_BLOB_READ_WRITE_TOKEN=
# Temporarily true during private migration; reads/text messages stay available.
PRIVATE_FILE_WRITES_PAUSED=false
MEDIA_BASE_URL=http://localhost:8010/media
MAX_UPLOAD_BYTES=26214400
# Upload body admission and isolated parser limits, per Python process.
UPLOAD_CONCURRENCY=2
UPLOAD_BODY_TIMEOUT_SECONDS=120
DOCUMENT_ARCHIVE_MAX_BYTES=50331648
DOCUMENT_ARCHIVE_MAX_MEMBER_BYTES=16777216
DOCUMENT_ARCHIVE_MAX_ENTRIES=2048
DOCUMENT_ARCHIVE_MAX_RATIO=200
DOCUMENT_MAX_PAGES=500
DOCUMENT_MAX_TEXT_BYTES=1048576
DOCUMENT_MAX_CHUNKS=4000
DOCUMENT_PARSER_MEMORY_MIB=256
DOCUMENT_PARSER_CPU_SECONDS=15
DOCUMENT_PARSER_TIMEOUT_SECONDS=20
DOCUMENT_PARSER_CONCURRENCY=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DAILY_USER_LIMIT=5
EMBEDDING_DIMENSIONS=768
LLM_PROVIDER=gemini
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8010/api/v1/auth/google/callback
PUBLIC_SITE_URL=http://localhost:5173
RESEND_API_KEY=
MAIL_FROM_EMAIL=
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RAG_TOP_K=12
RERANK_TOP_K=5
MAX_CONTEXT_TOKENS=5000
