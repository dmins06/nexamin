APP_ENV=development
APP_NAME=Nexamin
ASSISTANT_NAME=Emin AI
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://studyhub:change-me@postgres:5432/studyhub
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_ENABLED=true
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:5173
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=studyhub
S3_SECRET_KEY=replace-me
S3_BUCKET=studyhub-documents
S3_REGION=us-east-1
STORAGE_PROVIDER=local
MEDIA_BASE_URL=http://localhost:8010/media
MAX_UPLOAD_BYTES=26214400
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
LLM_PROVIDER=auto
EMBEDDING_PROVIDER=local
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8010/api/v1/auth/google/callback
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RAG_TOP_K=12
RERANK_TOP_K=5
MAX_CONTEXT_TOKENS=5000
