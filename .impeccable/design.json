{
  "name": "StudyHubAI",
  "direction": "Learning Observatory",
  "theme": "dark",
  "colors": {
    "background": "#070b14",
    "surface": "#0d1422",
    "raised": "#121c2d",
    "text": "#f5f7ff",
    "muted": "#9aa7bd",
    "primary": "#7c6cff",
    "accent": "#36d8ff",
    "success": "#4cdda5",
    "danger": "#ff7189"
  },
  "typography": {
    "display": "Space Grotesk",
    "body": "Manrope"
  },
  "layout": {
    "desktop": "236px minmax(0, 1fr) 286px",
    "tablet": "88px minmax(0, 1fr)",
    "mobile": "single column with 5-item bottom navigation",
    "range": "360-1600px"
  },
  "motion": {
    "duration": "180-380ms",
    "reducedMotion": true
  },
  "principles": [
    "real data only",
    "no timer UI",
    "keyboard accessible",
    "no horizontal overflow"
  ]
}
